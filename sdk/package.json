{
  "name": "@mobile-electron/core",
  "version": "2.0.0",
  "description": "Enterprise-grade Mobile Electron container client SDK for Android and iOS",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/mobile-electron-sdk.umd.js",
  "jsdelivr": "dist/mobile-electron-sdk.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node build.js"
  },
  "keywords": [
    "mobile-electron",
    "android",
    "ios",
    "hybrid",
    "webview",
    "profile-isolation",
    "stealth",
    "rpc-bridge"
  ],
  "author": "Mobile Electron Team",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
