{
  "name": "mobile-electron-project",
  "version": "2.0.0",
  "private": true,
  "description": "Mobile Electron hybrid application container for Android & iOS",
  "scripts": {
    "build:sdk": "npm --prefix sdk run build",
    "build:web": "npm --prefix web run build",
    "mode:local": "node scripts/prepare-build.js --mode local",
    "mode:online": "node scripts/prepare-build.js --mode online",
    "build:apk:local": "node scripts/prepare-build.js --mode local && gradlew assembleRelease",
    "build:apk:online": "node scripts/prepare-build.js --mode online && gradlew assembleRelease",
    "bundle:build": "node scripts/build-bundle.js",
    "bundle:serve": "node scripts/serve-update.js",
    "create:app": "node packages/create-mobile-electron-app/bin/cli.js",
    "cli": "node packages/cli/bin/mobile-electron.js",
    "doctor": "node packages/cli/bin/mobile-electron.js doctor",
    "run:android": "node packages/cli/bin/mobile-electron.js run android",
    "run:ios": "node packages/cli/bin/mobile-electron.js run ios",
    "pack:all": "node scripts/pack-packages.js",
    "test": "node tests/run-all.js"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1"
  }
}
