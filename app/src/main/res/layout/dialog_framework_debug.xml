<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- 顶部拖动手柄指示条 -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#CBD5E1" />

        <!-- 标题栏 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="框架调试中心 (Framework Debugger)"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_debug_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mobile Electron 运行时状态与 DevTools 控制器"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_close_debug_dialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_close" />
        </RelativeLayout>

        <!-- 卡片 1: DevTools 控制面板 (核心要求 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#F0FDF4"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 当前 WebView DevTools 控制"
                android:textColor="#166534"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_debug_active_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="活跃页面: http://127.0.0.1:5173"
                android:textColor="#15803D"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="原生已开启 setWebContentsDebuggingEnabled；点击下方可在屏幕直接唤出或收起 DevTools 面板："
                android:textColor="#374151"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_open_webview_devtools"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="#16A34A"
                    android:text="打开当前 DevTools"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btn_close_webview_devtools"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="#DC2626"
                    android:text="关闭 DevTools"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="PC 端可用: chrome://inspect (端口映射 9222)"
                android:textColor="#6B7280"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 卡片 2: 框架运行时状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 容器运行环境与状态 (Runtime Stats)"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_debug_runtime_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="平台: Android | PID: ... | 内存: ... MB"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_debug_pages_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="页面池实例: 1 前台活跃 | 0 后台无头"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 卡片 3: 原生工具与快捷入口矩阵 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="🛠️ 框架能力快捷控制"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_debug_cookie_hub"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#4F46E5"
                android:text="Cookie中心"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_debug_page_manager"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#0284C7"
                android:text="页面管理"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_debug_whitelist"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#475569"
                android:text="安全沙箱"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_debug_toggle_topbar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#E2E8F0"
                android:text="切换原生地址栏"
                android:textColor="#1E293B"
                android:textSize="11sp" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_debug_toggle_tabbar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#E2E8F0"
                android:text="切换原生TabBar"
                android:textColor="#1E293B"
                android:textSize="11sp" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_debug_hard_reload"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#E2E8F0"
                android:text="强制刷新"
                android:textColor="#1E293B"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
