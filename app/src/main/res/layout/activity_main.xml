<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 顶部现代化应用栏 (Edge-to-Edge App Bar) -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#FFFFFF">

        <!-- 胶囊化安全地址栏 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_address_bar"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <!-- SSL / 安全状态图标 -->
            <ImageView
                android:id="@+id/iv_security_lock"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="Security Lock" />

            <!-- 地址输入框 -->
            <EditText
                android:id="@+id/et_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="输入网址或进行搜索..."
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />

            <!-- 清除地址按钮 -->
            <ImageView
                android:id="@+id/iv_clear_url"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                android:padding="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear" />
        </LinearLayout>

        <!-- 刷新按钮 -->
        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh" />

        <!-- 顶部开发者测试控制台快捷入口 -->
        <ImageView
            android:id="@+id/btn_top_console"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_terminal"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="DevTools Console" />
    </LinearLayout>

    <!-- 加载进度条 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/primary"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 中间动态网页主容器 (支持前后台 WebView 自由互换挂载) -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 悬浮调试球快捷入口 (默认隐藏，可由接口开启) -->
        <ImageView
            android:id="@+id/btn_floating_debug"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_floating_debug"
            android:padding="10dp"
            android:src="@drawable/ic_bug"
            android:tint="#FFFFFF"
            android:elevation="10dp"
            android:visibility="gone"
            android:contentDescription="Debug Console" />
    </FrameLayout>

    <!-- 离线/后台无头 WebView 容器 (1dp 隐形挂载，保持运行时不被休眠) -->
    <FrameLayout
        android:id="@+id/offscreen_container"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 商业级五位导航底栏 (Commercial Bottom Navigation Toolbar) -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bottom_bar_bg"
        android:elevation="6dp">

        <!-- 1. 后退 -->
        <LinearLayout
            android:id="@+id/btn_nav_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_nav_back"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后退"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 2. 前进 -->
        <LinearLayout
            android:id="@+id/btn_nav_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_nav_forward"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_arrow_forward"
                android:contentDescription="Forward" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="前进"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 3. Cookie 管理中心 (带角标 Badge) -->
        <LinearLayout
            android:id="@+id/btn_nav_cookie_hub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_cookie"
                    android:contentDescription="Cookie Hub" />

                <!-- Cookie 数量角标 -->
                <TextView
                    android:id="@+id/tv_cookie_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_badge"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cookie中心"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 4. 多页面与后台任务调度中心 (带运行数角标) -->
        <LinearLayout
            android:id="@+id/btn_nav_pages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_page_manager"
                    android:contentDescription="Page Manager" />

                <!-- 运行中页面/任务角标 -->
                <TextView
                    android:id="@+id/tv_pages_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_badge"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="页面/任务"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 5. 安全沙箱 / 白名单 -->
        <LinearLayout
            android:id="@+id/btn_nav_security"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shield_check"
                android:contentDescription="Security" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="安全沙箱"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 动态定制原生 TabBar (默认隐藏，支持动态设置标题与图标) -->
    <LinearLayout
        android:id="@+id/layout_native_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:visibility="gone" />

</LinearLayout>
