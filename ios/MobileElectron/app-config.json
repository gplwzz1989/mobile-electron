{
  "app": {
    "name": "Mobile Electron App",
    "appId": "com.example.mobileelectron",
    "version": "2.0.0"
  },
  "window": {
    "defaultUrl": "file:///dist/index.html",
    "title": "Mobile Electron Application",
    "fullscreen": false,
    "immersiveStatusBar": true,
    "statusBarColor": "#FFFFFF",
    "statusBarDarkIcons": true,
    "showNativeDebugToolbar": false
  },
  "security": {
    "whitelist": [
      "file://*",
      "https://*.baidu.com",
      "https://*.douyin.com",
      "https://*.amemv.com",
      "http://localhost",
      "m.baidu.com"
    ],
    "allowInsecureContent": true
  },
  "profile": {
    "defaultProfile": "default",
    "hardwarePreset": "flagship"
  }
}